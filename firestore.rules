rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminOrHost() {
      return request.auth != null && request.auth.token.email in [
        'tkm/admin@tkmrrnagar.bhikshu',
        'tkm/host@tkmrrnagar.bhikshu'
      ];
    }

    function isPlayer() {
      return request.auth != null && request.auth.token.email == 'tkm/player@tkmrrnagar.bhikshu';
    }

    function isStaff() {
      return isAdminOrHost() || isPlayer();
    }

    function publicState() {
      return get(/databases/$(database)/documents/gameSessions/active/public/state).data;
    }

    function validContestantUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (
        changed.hasOnly(['selectedOption']) &&
        publicState().stage == 'QUESTION_ACTIVE' &&
        request.resource.data.selectedOption in ['A', 'B', 'C', 'D']
      ) || (
        changed.hasOnly(['stage', 'timer', 'timerEndsAt']) &&
        resource.data.stage == 'QUESTION_ACTIVE' &&
        request.resource.data.stage == 'ANSWER_LOCKED' &&
        request.resource.data.timer.isRunning == false &&
        request.resource.data.timer.duration == resource.data.timer.duration &&
        request.resource.data.timer.timerMode == resource.data.timer.timerMode &&
        request.resource.data.timer.secondsRemaining == resource.data.timer.secondsRemaining
      ) || (
        changed.hasOnly(['stage', 'timer', 'timerEndsAt', 'hotSeatContestant']) &&
        resource.data.stage == 'QUESTION_ACTIVE' &&
        request.resource.data.stage == 'CONTESTANT_QUIT' &&
        request.resource.data.timer.isRunning == false &&
        request.resource.data.hotSeatContestant.id == resource.data.hotSeatContestant.id &&
        request.resource.data.hotSeatContestant.name == resource.data.hotSeatContestant.name
      );
    }

    match /gameSessions/active/public/state {
      allow read: if true;
      allow create, delete: if isAdminOrHost();
      allow update: if isAdminOrHost() || (isPlayer() && validContestantUpdate());
    }

    match /gameSessions/active/private/state {
      allow read: if isAdminOrHost();
      allow create, delete: if isAdminOrHost();
      allow update: if isAdminOrHost() || (isPlayer() && validContestantUpdate());
    }

    match /gameSessions/active/participants/{participantId} {
      allow read: if isStaff();
      allow create: if request.resource.data.id == participantId &&
        request.resource.data.seatId == participantId &&
        request.resource.data.name is string && request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 40 &&
        request.resource.data.roomCode == publicState().roomCode &&
        request.resource.data.sessionId == publicState().sessionId &&
        publicState().registrationOpen == true &&
        getAfter(/databases/$(database)/documents/gameSessions/active/seats/$(participantId)).data.claimed == true &&
        getAfter(/databases/$(database)/documents/gameSessions/active/seats/$(participantId)).data.sessionId == publicState().sessionId;
      allow update, delete: if false;
    }

    match /gameSessions/active/seats/{seatId} {
      allow read: if true;
      allow create: if isAdminOrHost() || (request.auth == null &&
        request.resource.data.claimed == true &&
        request.resource.data.sessionId == publicState().sessionId &&
        request.resource.data.roomCode == publicState().roomCode &&
        publicState().registrationOpen == true &&
        existsAfter(/databases/$(database)/documents/gameSessions/active/participants/$(seatId)) &&
        getAfter(/databases/$(database)/documents/gameSessions/active/participants/$(seatId)).data.seatId == seatId);
      allow update, delete: if isAdminOrHost();
    }

    match /gameSessions/active/fffSubmissions/{participantId} {
      allow read: if isStaff();
      allow create: if request.resource.data.participantId == participantId &&
        request.resource.data.submittedOrder is list &&
        request.resource.data.submittedOrder.size() == 4 &&
        exists(/databases/$(database)/documents/gameSessions/active/participants/$(participantId)) &&
        publicState().stage == 'FFF_ACTIVE' &&
        request.time.toMillis() < publicState().timerEndsAt &&
        request.resource.data.roundStart == publicState().fffStartTime &&
        request.resource.data.submittedOrder == get(/databases/$(database)/documents/gameSessions/active/private/state).data.fullFffQuestion.correctOrder;
      allow update: if request.resource.data.participantId == participantId &&
        request.resource.data.submittedOrder is list &&
        request.resource.data.submittedOrder.size() == 4 &&
        exists(/databases/$(database)/documents/gameSessions/active/participants/$(participantId)) &&
        publicState().stage == 'FFF_ACTIVE' &&
        request.time.toMillis() < publicState().timerEndsAt &&
        request.resource.data.roundStart == publicState().fffStartTime &&
        request.resource.data.submittedOrder == get(/databases/$(database)/documents/gameSessions/active/private/state).data.fullFffQuestion.correctOrder &&
        resource.data.roundStart != request.resource.data.roundStart;
      allow delete: if isAdminOrHost();
    }

    match /gameSessions/active/pollVotes/{participantId} {
      allow read: if isStaff();
      allow create: if request.resource.data.participantId == participantId &&
        request.resource.data.optionKey in ['A', 'B', 'C', 'D'] &&
        exists(/databases/$(database)/documents/gameSessions/active/participants/$(participantId)) &&
        publicState().lifelines.audiencePoll.active == true &&
        request.time.toMillis() < publicState().pollEndsAt &&
        request.resource.data.pollId == publicState().pollId;
      allow update: if request.resource.data.participantId == participantId &&
        request.resource.data.optionKey in ['A', 'B', 'C', 'D'] &&
        exists(/databases/$(database)/documents/gameSessions/active/participants/$(participantId)) &&
        publicState().lifelines.audiencePoll.active == true &&
        request.time.toMillis() < publicState().pollEndsAt &&
        request.resource.data.pollId == publicState().pollId &&
        resource.data.pollId != request.resource.data.pollId;
      allow delete: if isAdminOrHost();
    }
  }
}
