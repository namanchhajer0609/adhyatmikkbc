rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.email.matches(".*@admin\\.kbc"));
    }

    // Public game state (sanitized): Read-only to audience, write restricted to Admin
    match /gameSessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();

      // Participants collection: Anyone can register themselves once
      match /participants/{participantId} {
        allow read: if true;
        allow create: if request.resource.data.name is string && request.resource.data.name.size() >= 2;
        allow update, delete: if isAdmin();
      }

      // Fastest Finger First submissions: Each participant submits once
      match /fffSubmissions/{submissionId} {
        allow read: if isAdmin();
        allow create: if request.resource.data.participantId is string &&
                         request.resource.data.submittedOrder is list;
        allow update, delete: if isAdmin();
      }

      // Audience Poll votes: 1 vote per registered participant
      match /pollVotes/{participantId} {
        allow read: if isAdmin();
        allow write: if request.resource.data.optionKey in ['A', 'B', 'C', 'D'];
      }
    }

    // Secret Question Bank: Strictly restricted to Admin!
    // Correct answers must NEVER be read by client participants!
    match /questionBank/{questionId} {
      allow read, write: if isAdmin();
    }
  }
}
